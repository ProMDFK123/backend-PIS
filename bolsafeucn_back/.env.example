# Variables de entorno sensibles - NO subir a Git
# Copiar a .env y llenar con valores reales

# Database (PostgreSQL)
# Render proporciona DATABASE_URL automáticamente
DATABASE_URL=postgresql://user:password@host:5432/database
ConnectionStrings__DefaultConnection=Server=localhost;Port=5432;Database=NOMBRE_DB;Username=USUARIO;Password=PASSWORD;

# JWT (Generar con: openssl rand -base64 32)
Jwt__Key=TU_CLAVE_JWT_MINIMO_32_CARACTERES

# Resend (https://resend.com/api-keys)
ResendApiKey=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Cloudinary (https://cloudinary.com/console)
Cloudinary__CloudName=TU_CLOUD_NAME
Cloudinary__ApiKey=123456789012345
Cloudinary__ApiSecret=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Environment
ASPNETCORE_ENVIRONMENT=Development
